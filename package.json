{
  "name": "star-news-photocard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "astro check && astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint src tests scripts --max-warnings 0",
    "build:staging": "node scripts/environment.mjs staging",
    "build:production": "node scripts/environment.mjs production",
    "deploy:staging": "node scripts/environment.mjs staging deploy",
    "deploy:production": "node scripts/environment.mjs production deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "astro": "7.3.8",
    "html2canvas": "1.4.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261009.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.12.0",
    "miniflare": "^5.20261006.1-alpha",
    "rolldown": "^1.2.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
