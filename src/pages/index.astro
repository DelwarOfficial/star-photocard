---
import PhotocardEditor from '../components/editor/PhotocardEditor';
import AppLayout from '../layouts/AppLayout.astro';
import { S } from '../lib/i18n/strings';
import { readImageSecret, workerEnv } from '../lib/security/imageSecret';

// Fail fast: tell the editor on page load whether article photos can be served at all.
const imageSigningReady = readImageSecret(await workerEnv()) !== '';
---
<AppLayout title={S.page.title} description={S.page.description}>
  <main>
    <PhotocardEditor client:load imageSigningReady={imageSigningReady} />
  </main>
</AppLayout>
